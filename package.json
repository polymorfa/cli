{
  "name": "@polymorfa/cli",
  "version": "0.1.0-dev.0",
  "description": "The official command-line interface for Polymorfa",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "polymorfa": "./bin/run.js"
  },
  "files": [
    "bin/run.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit:prod": "npm audit --omit=dev",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run --ignore-scripts && npm run audit:prod"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@oclif/core": "^4.13.5",
    "@polymorfa/sdk": "github:polymorfa/sdks#873fb817e4967f8c1d032fb73216774c64ec21f5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oclif/test": "^4.1.22",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "3.2.7"
  },
  "oclif": {
    "bin": "polymorfa",
    "dirname": "polymorfa",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "auth": {
        "description": "Manage authentication profiles and credentials."
      },
      "group": {
        "description": "Inspect and manage Messaging groups."
      },
      "message": {
        "description": "Send messages and perform message actions."
      },
      "media": {
        "description": "Inspect, download, and persist Messaging media."
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymorfa/cli.git"
  }
}
